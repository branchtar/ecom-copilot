# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---- Cognito Hosted UI / OIDC ----
# Example issuer: https://YOURDOMAIN.auth.us-east-1.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.YOUR_REGION.amazonaws.com/YOUR_USER_POOL_ID
COGNITO_CLIENT_ID=REPLACE
COGNITO_CLIENT_SECRET=REPLACE

# ---- Your existing API (AppRunner) ----
NEXT_PUBLIC_API_BASE_URL=https://5xhzibtfry.us-east-1.awsapprunner.com

# ---- Internal server-to-server key (Amazon Orders proxy) ----
# Set the SAME value in both the Next.js and FastAPI environments.
# Never add NEXT_PUBLIC_ prefix — this key must never reach the browser.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(40))"
ECOM_INTERNAL_API_KEY=REPLACE

# ---- Amazon SP-API ----
# Marketplace ID — default is ATVPDKIKX0DER (Amazon.com US).
# Only set this if you sell on a different Amazon marketplace.
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# ---- Workspace profile (Phase 3B-1) ----
# Set in the FastAPI (App Runner) environment — NOT here in Next.js.
# Documented here for reference only.
#
# WORKSPACE_BACKEND=secretsmanager       # "secretsmanager" (default) or "local" (dev)
# WORKSPACE_SECRETS_PREFIX=ecom-navigation/workspaces   # Secrets Manager path prefix
# WORKSPACE_LOCAL_DIR=/tmp/ecom_local_data              # Only used when WORKSPACE_BACKEND=local
#
# App Runner instance role must allow on arn:...:secret:ecom-navigation/workspaces/*:
#   secretsmanager:GetSecretValue
#   secretsmanager:CreateSecret
#   secretsmanager:PutSecretValue
#   secretsmanager:DescribeSecret
#   secretsmanager:TagResource