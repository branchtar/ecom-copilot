# ---- API SERVER ----
# Required in App Runner:

# Amazon SP-API OAuth (Login With Amazon credentials from your SP-API app)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# Fernet key used to encrypt persisted Amazon seller tokens at rest.
# Generate one locally with:
#     python api/amazon_oauth.py gen-key
AMAZON_TOKEN_ENC_KEY=

# Amazon SP-API app identity + callback (used by /api/integrations/amazon/start)
AMAZON_SPAPI_APP_ID=
AMAZON_SPAPI_REDIRECT_URI=
# While the SP-API app is still in DRAFT, the authorize URL must include
# version=beta. Set this to true until Amazon promotes the app to published.
AMAZON_SPAPI_USE_BETA=true

# Optional:
# PORT=8080
# AMAZON_SELLER_CENTRAL_BASE=https://sellercentral.amazon.com
