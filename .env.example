# ---- API SERVER ----
# Required in App Runner:

# Amazon SP-API OAuth (Login With Amazon credentials from your SP-API app)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# ---- Token storage backend ----
# Controls where Amazon seller connections (tokens) are persisted.
#
#   secretsmanager  — AWS Secrets Manager (PRODUCTION, durable on App Runner)
#   local           — Encrypted JSON file in data/ (LOCAL DEV ONLY, ephemeral
#                     on App Runner — lost on every restart/deploy/scale event)
#
# Set to secretsmanager in App Runner env vars.
# Defaults to local if not set, so local dev works without AWS credentials.
AMAZON_CONNECTION_STORE=secretsmanager

# AWS Secrets Manager prefix for stored seller connections (secretsmanager only).
# Secrets are stored as: {prefix}/{tenant}/{selling_partner_id}
# The App Runner instance role must allow secretsmanager:* on this prefix.
AMAZON_SECRETS_PREFIX=ecom-copilot/amazon

# Fernet key used to encrypt persisted tokens when using the local store.
# Only required when AMAZON_CONNECTION_STORE=local (dev only).
# Generate one with:  python api/amazon_oauth.py gen-key
# Not needed in production (secretsmanager backend uses KMS instead).
AMAZON_TOKEN_ENC_KEY=

# Amazon SP-API app identity + callback (used by /api/integrations/amazon/start)
AMAZON_SPAPI_APP_ID=
AMAZON_SPAPI_REDIRECT_URI=
# While the SP-API app is still in DRAFT, the authorize URL must include
# version=beta. Set this to true until Amazon promotes the app to published.
AMAZON_SPAPI_USE_BETA=true

# Optional:
# PORT=8080
# AMAZON_SELLER_CENTRAL_BASE=https://sellercentral.amazon.com
